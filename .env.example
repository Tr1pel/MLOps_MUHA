# Local development only. Copy to .env and choose a password before starting Compose.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_platform
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-local
APP_PORT=8000
HEALTH_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
APP_COMMIT=unknown
MODEL_NAME=fly-policy
MODEL_ALIAS=champion
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PORT=5000
MLFLOW_DB=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=change-me-mlflow-local
MLFLOW_BUCKET=mlflow
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# RabbitMQ and the task pipeline
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=agent
RABBITMQ_PASSWORD=change-me-rabbit-local
TASKS_QUEUE=tasks
QUEUE_MAX_LENGTH=50
TASK_DELIVERY_LIMIT=3
INFERENCE_SECONDS=0.5
WORKER_CONCURRENCY=2
WORKER_HEALTH_PORT=8001
PUBLISH_TIMEOUT_SECONDS=2
