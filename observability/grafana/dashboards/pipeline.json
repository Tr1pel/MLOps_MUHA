          "expr": "sum(rate(worker_tasks_processed_total{result=\"ok\"}[1m]))",
          "legendFormat": "воркеры (сумма), задач/с",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
