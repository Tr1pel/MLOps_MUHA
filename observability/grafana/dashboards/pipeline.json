        "definition": "label_values(process_memory_usage_bytes, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "instance",
        "label": "Воркер (instance)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(worker_tasks_processed_total, instance)",
          "refId": "v"
        },
        "definition": "label_values(worker_tasks_processed_total, instance)",
